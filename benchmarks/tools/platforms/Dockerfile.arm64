# FellowEngine platform checks (milestone 49): the Linux arm64 build rendering on an x86_64 host, under qemu-user, with
# Ubuntu's arm64 Mesa (lavapipe for Vulkan, llvmpipe for OpenGL) and X libraries, and an x86_64 Xvfb for its window.
#   qemu-aarch64 -L / bin/godot.linuxbsd.template_release.arm64 ...
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
COPY certs/ /tmp/certs/
RUN (cat /tmp/certs/*.crt >> /etc/ssl/certs/ca-certificates.crt 2>/dev/null || true) \
	&& sed -i 's/^Types: deb$/Types: deb\nArchitectures: amd64/' /etc/apt/sources.list.d/ubuntu.sources \
	&& printf 'Types: deb\nURIs: http://ports.ubuntu.com/ubuntu-ports\nSuites: noble noble-updates noble-security\nComponents: main universe\nArchitectures: arm64\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' \
		> /etc/apt/sources.list.d/ubuntu-ports.sources \
	&& dpkg --add-architecture arm64 \
	&& apt-get update && apt-get install -y --no-install-recommends \
		ca-certificates qemu-user xvfb xauth python3 \
		libc6:arm64 libstdc++6:arm64 libvulkan1:arm64 mesa-vulkan-drivers:arm64 libgl1-mesa-dri:arm64 libgl1:arm64 \
		libegl1:arm64 libx11-6:arm64 libxcursor1:arm64 libxinerama1:arm64 libxrandr2:arm64 libxrender1:arm64 \
		libxi6:arm64 libxext6:arm64 libxkbcommon0:arm64 libdbus-1-3:arm64 \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /src
