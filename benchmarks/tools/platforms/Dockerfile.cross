# FellowEngine platform checks (milestone 49): cross-compilers for Godot's Linux arm64 and Windows x86_64 export
# templates, and qemu-user to run the arm64 build headless on an x86_64 host.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
COPY certs/ /tmp/certs/
RUN apt-get update && apt-get install -y --no-install-recommends \
		ca-certificates build-essential pkg-config python3 scons git \
		g++-aarch64-linux-gnu binutils-aarch64-linux-gnu qemu-user \
		g++-mingw-w64-x86-64-posix gcc-mingw-w64-x86-64-posix binutils-mingw-w64-x86-64 \
	&& rm -rf /var/lib/apt/lists/* \
	&& (cat /tmp/certs/*.crt >> /etc/ssl/certs/ca-certificates.crt 2>/dev/null || true) \
	&& update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
	&& update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix
# Godot's linuxbsd build calls the host's ar and ranlib: give the arm64 build its own through a PATH prefix.
RUN mkdir -p /opt/arm64-bin && for t in ar ranlib nm strip objcopy; do ln -s /usr/bin/aarch64-linux-gnu-$t /opt/arm64-bin/$t; done
WORKDIR /src
