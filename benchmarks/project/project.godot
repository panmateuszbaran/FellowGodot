; FellowEngine benchmark project.
; Must stay loadable by BOTH untouched stock Godot 4.7.2 and FellowEngine builds.
; Every quality-relevant setting is either fixed here or applied at runtime by
; res://bench/presets.gd and exported into each result file.

config_version=5

[application]

config/name="FellowBench"
config/description="Deterministic rendering benchmarks: stock Godot vs FellowEngine"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false
run/max_fps=0
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="FellowBench"

[debug]

settings/profiler/max_timestamp_query_elements=2048
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=1
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/inferred_declaration=0
settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/borderless=true
window/vsync/vsync_mode=0
window/stretch/mode="disabled"
window/energy_saving/keep_screen_on=true

[editor_plugins]

enabled=PackedStringArray()

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=1

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=false
textures/decals/filter=5
textures/light_projectors/filter=5
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
environment/screen_space_reflection/roughness_quality=2
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=false
