extends "res://bench/scene_base.gd"
## MOTION LAB (built in code): characters whose whole-body motion a neural network generates on the GPU
## (FellowMotionCharacter3D, docs/decisions/0143-neural-motion.md).
##
## --motion_crowd=N characters (default 16) wander a plaza: each walks, jogs or runs to waypoints at its own pace,
## swerves round the others, stops and stands a while. None plays an animation clip: every 0.6-1.9 s of each one's
## motion is generated by NVIDIA's MotionBricks SOMA model (converted to an .fmb by modules/fellow_motion/tools; the
## weights are not part of this repository: --motion_model=<path>, --motion_body=<the mannequin .glb>) from the four
## poses it last showed towards a target ahead of it, the requests of all characters run as one batch on the model's
## own GPU device.
##
## The simulation steps at 60 Hz from set_time(); a step back in time continues it (--motion_rewind=1: rebuilds it
## from t = 0, the same frames again). --motion_mode=flush
## (default): each step's requests run as one batch at the step's end and are taken the next step (deterministic);
## async: on the service's worker thread as they come (results when they are ready); immediate: each at once.

const STEP := 1.0 / 60.0

var sun: DirectionalLight3D
var crowd := 16
var model_path := ""
var body_path := ""
var mode := "flush"
var _area := 16.0
var _chars: Array = []
var _rng_state: Array = []  # per character: [waypoint, pause_left, speed, rng]
var _sim_t := 0.0
var _last_t := 0.0
var _acc := 0.0
var _rewind := false
var _root: Node3D


func build(p_args: Dictionary) -> void:
	args = p_args
	bench_name = "motion"
	crowd = int(args.get("motion_crowd", "16"))
	model_path = str(args.get("motion_model", OS.get_environment("FELLOW_MOTION_MODEL")))
	body_path = str(args.get("motion_body", OS.get_environment("FELLOW_MOTION_BODY")))
	mode = str(args.get("motion_mode", "flush"))
	_rewind = str(args.get("motion_rewind", "0")) == "1"
	_area = clampf(sqrt(float(crowd)) * 4.0, 12.0, 60.0)
	_setup_common()
	_setup_environment()
	_build_ground()
	_build_lights()
	if not ClassDB.class_exists("FellowMotionCharacter3D"):
		load_error = "this build has no FellowMotionCharacter3D (modules/fellow_motion)"
		return
	if model_path == "" or not FileAccess.file_exists(model_path):
		load_error = "no motion model: pass --motion_model=<soma .fmb> (modules/fellow_motion/tools/fmb_convert.py)"
		return
	_root = Node3D.new()
	_root.name = "Crowd"
	add_child(_root)
	_build_crowd()
	_define_cameras()
	info = {"stats": scene_stats(self), "characters": crowd, "mode": mode, "model": model_path.get_file(),
		"body": body_path.get_file(),
		"notes": "Neural motion: FellowMotionCharacter3D, MotionBricks SOMA on the GPU, root-only targets, batched requests."}


func _setup_environment() -> void:
	env.background_mode = Environment.BG_SKY
	var sky := Sky.new()
	var sm := ProceduralSkyMaterial.new()
	sm.sky_top_color = Color(0.32, 0.47, 0.72)
	sm.sky_horizon_color = Color(0.72, 0.76, 0.8)
	sm.ground_horizon_color = Color(0.5, 0.48, 0.45)
	sky.sky_material = sm
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.ssao_enabled = true


func _build_ground() -> void:
	var img := Image.create(256, 256, true, Image.FORMAT_RGB8)
	for y in 256:
		for x in 256:
			var tile := ((x / 32) + (y / 32)) % 2
			var v := 0.46 if tile == 0 else 0.4
			var seam := 1.0 if (x % 32 == 0 or y % 32 == 0) else 0.0
			v -= seam * 0.08
			img.set_pixel(x, y, Color(v, v * 0.98, v * 0.95))
	img.generate_mipmaps()
	var m := StandardMaterial3D.new()
	m.albedo_texture = ImageTexture.create_from_image(img)
	m.roughness = 0.85
	m.uv1_scale = Vector3(_area * 0.5, _area * 0.5, 1)
	var mi := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = Vector2(_area * 2.0, _area * 2.0)
	mi.mesh = pm
	mi.material_override = m
	add_child(mi)


func _build_lights() -> void:
	sun = DirectionalLight3D.new()
	sun.rotation = Vector3(deg_to_rad(-48.0), deg_to_rad(-35.0), 0.0)
	sun.light_energy = 1.3
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = _area * 2.5
	add_child(sun)


func _new_rng(i: int) -> RandomNumberGenerator:
	var r := RandomNumberGenerator.new()
	r.seed = 7919 * (i + 1)
	return r


func _build_crowd() -> void:
	for c in _chars:
		c.queue_free()
	_chars.clear()
	_rng_state.clear()
	var cols := int(ceil(sqrt(float(crowd))))
	for i in crowd:
		var r := _new_rng(i)
		var ch = ClassDB.instantiate("FellowMotionCharacter3D")
		ch.name = "Character%d" % i
		ch.model_path = model_path
		ch.body_path = body_path
		ch.max_batch = maxi(crowd, 1)
		ch.auto_process = false
		ch.inference_mode = {"async": 0, "flush": 1, "immediate": 2}.get(mode, 1)
		ch.body_color = Color.from_hsv(r.randf(), 0.25 + 0.3 * r.randf(), 0.55 + 0.35 * r.randf())
		var gx := (i % cols - (cols - 1) * 0.5) * (_area * 1.4 / cols)
		var gz := (i / cols - (cols - 1) * 0.5) * (_area * 1.4 / cols)
		ch.position = Vector3(gx, 0, gz)
		ch.rotation = Vector3(0, r.randf() * TAU, 0)
		_root.add_child(ch)
		_chars.append(ch)
		# Pace: walkers, joggers, runners, idlers.
		var kind := r.randf()
		var sp := r.randf_range(1.1, 1.5) if kind < 0.45 else (r.randf_range(2.4, 3.0) if kind < 0.75 else (r.randf_range(3.4, 4.2) if kind < 0.9 else r.randf_range(1.0, 1.3)))
		var pause_bias := 0.6 if kind >= 0.9 else 0.25
		_rng_state.append({"wp": _waypoint(r), "pause": r.randf_range(0.0, 1.0), "speed": sp, "rng": r, "pause_bias": pause_bias})
	_sim_t = 0.0
	_last_t = 0.0
	_acc = 0.0


func _waypoint(r: RandomNumberGenerator) -> Vector3:
	return Vector3(r.randf_range(-_area * 0.8, _area * 0.8), 0, r.randf_range(-_area * 0.8, _area * 0.8))


func _steer(i: int, dt: float) -> void:
	var ch = _chars[i]
	var s: Dictionary = _rng_state[i]
	var pos: Vector3 = ch.global_position
	pos.y = 0
	if s["pause"] > 0.0:
		s["pause"] -= dt
		ch.desired_velocity = Vector3.ZERO
		return
	var to: Vector3 = s["wp"] - pos
	var d := to.length()
	if d < 1.0:
		var r: RandomNumberGenerator = s["rng"]
		s["wp"] = _waypoint(r)
		if r.randf() < s["pause_bias"]:
			s["pause"] = r.randf_range(2.0, 5.0)
			ch.desired_velocity = Vector3.ZERO
			return
		to = s["wp"] - pos
		d = to.length()
	var v: Vector3 = to / maxf(d, 1e-3) * float(s["speed"])
	# Separation from the others within 1.6 m.
	var push := Vector3.ZERO
	for j in _chars.size():
		if j == i:
			continue
		var o: Vector3 = _chars[j].global_position
		o.y = 0
		var dd := pos - o
		var l := dd.length()
		if l > 1e-3 and l < 1.6:
			push += dd / l * (1.6 - l)
	v += push * 2.5
	if v.length() > float(s["speed"]):
		v = v.normalized() * float(s["speed"])
	ch.desired_velocity = v


func _step(dt: float) -> void:
	for i in _chars.size():
		_steer(i, dt)
	for ch in _chars:
		ch.advance(dt)
	if mode == "flush":
		ClassDB.class_call_static("FellowMotionCharacter3D", "flush_requests", model_path)
	_sim_t += dt


func set_time(t: float) -> void:
	if _chars.is_empty():
		return
	if t + 1e-6 < _last_t:
		if _rewind:
			_build_crowd()
		else:
			_last_t = t
	_acc += t - _last_t
	_last_t = t
	while _acc >= STEP * 0.5:
		_step(STEP)
		_acc -= STEP


func sample_extra() -> Dictionary:
	if model_path == "" or not ClassDB.class_exists("FellowMotionCharacter3D"):
		return {}
	var s: Dictionary = ClassDB.class_call_static("FellowMotionCharacter3D", "get_service_stats", model_path)
	var d := {}
	for k in ["requests", "batches", "avg_batch", "avg_batch_msec", "last_batch", "last_batch_msec", "max_batch_seen", "pending"]:
		if s.has(k):
			d["motion_" + k] = s[k]
	return d


func _define_cameras() -> void:
	var h := _area
	fixed_cameras = {
		"motion_aerial": {"pos": Vector3(-h * 0.9, h * 0.7, h * 0.9), "target": Vector3(0, 0, 0), "fov": 55.0, "time": 12.0, "purpose": "the whole crowd from above"},
		"motion_street": {"pos": Vector3(0.0, 1.6, h * 0.75), "target": Vector3(0, 1.0, -h * 0.4), "fov": 60.0, "time": 12.0, "purpose": "eye level in the plaza: walkers, joggers, runners"},
		"motion_close": {"pos": Vector3(2.5, 1.4, 3.5), "target": Vector3(0, 0.95, 0), "fov": 45.0, "time": 12.0, "purpose": "a few characters near the middle, full size"},
	}
	flythrough = CameraPath.from_array([
		[0.0, Vector3(-h * 0.9, h * 0.7, h * 0.9), Vector3(0, 0, 0), 55.0],
		[10.0, Vector3(h * 0.7, h * 0.35, h * 0.7), Vector3(0, 0.5, 0), 55.0],
		[20.0, Vector3(0.0, 1.6, h * 0.75), Vector3(0, 1.0, -h * 0.4), 60.0],
		[30.0, Vector3(h * 0.8, 2.5, -h * 0.6), Vector3(0, 0.8, 0), 55.0],
	])
	temporal_seqs = {
		"motion_walk": {"start": 6.0, "frames": 240, "purpose": "4 s of the crowd at eye level (a loop's frames)",
			"path": CameraPath.from_array([[0.0, Vector3(-4, 1.6, h * 0.6), Vector3(0, 1.0, -h * 0.3), 55.0], [4.0, Vector3(4, 1.6, h * 0.6), Vector3(0, 1.0, -h * 0.3), 55.0]])},
	}
